{
  "name": "User",
  "type": "object",
  "properties": {
    "perfil": {
      "type": "string",
      "enum": [
        "comercial",
        "logistica",
        "gestor_frota",
        "administrador",
        "visitante"
      ],
      "default": "visitante",
      "description": "Perfil do utilizador"
    },
    "departamento": {
      "type": "string",
      "description": "Departamento do utilizador"
    },
    "nome_comercial": {
      "type": "string",
      "description": "Nome espec\u00edfico do comercial (extra\u00eddo da senha)"
    },
    "password": {
      "type": "string",
      "description": "Senha do perfil"
    },
    "ultimo_acesso": {
      "type": "string",
      "format": "date-time",
      "description": "\u00daltimo acesso ao sistema"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se o perfil est\u00e1 ativo"
    }
  },
  "required": [
    "perfil",
    "departamento"
  ]
}