{
  "name": "Maquina",
  "type": "object",
  "properties": {
    "serie": {
      "type": "string",
      "description": "Número de série — chave de identificação"
    },
    "modelo": {
      "type": "string",
      "description": "Modelo da máquina"
    },
    "ano": {
      "type": "string",
      "description": "Ano de fabrico"
    },
    "foto_url": {
      "type": "string",
      "description": "URL da foto da máquina/placa"
    },
    "mastro": {
      "type": "string",
      "description": "Tipo de mastro (triplex, telescopico, niho, simplex)"
    },
    "elevacao_livre_150": {
      "type": "boolean",
      "description": "Mastro com elevação livre de 150 mm (versão dos EXV telescópicos). Muda o H1; só se grava quando a tabela de mastros tem essa versão para o modelo e mastro."
    },
    "vias_mastro": {
      "type": "string",
      "description": "Número de vias do mastro (3, 4, 5)"
    },
    "joystick": {
      "type": "string",
      "description": "Tipo de joystick (alavanca, minilever, 4plus, fingertrip)"
    },
    "tipo_pneu": {
      "type": "string",
      "description": "Cor do pneu (preto, branco)"
    },
    "h3": {
      "type": "string",
      "description": "Altura máxima do mastro em mm (H3)"
    },
    "h1": {
      "type": "string",
      "description": "Altura do mastro recolhido em mm (H1). Calculada pela tabela de mastros a partir de modelo + mastro + H3; não se escreve à mão."
    },
    "h1_origem": {
      "type": "string",
      "description": "De onde veio o H1: 'tabela' (valor da ficha) ou 'estimado' (H3 entre dois valores da ficha, interpolado). Vazio = sem H1."
    },
    "bateria": {
      "type": "string",
      "enum": [
        "chumbo",
        "litio"
      ],
      "description": "Tipo de bateria (chumbo, litio)"
    },
    "acessorios": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de acessórios"
    },
    "observacoes": {
      "type": "string",
      "description": "Observações gerais"
    },
    "horimetro": {
      "type": "string",
      "description": "Horas de trabalho marcadas no horímetro (opcional)"
    },
    "fotos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Fotografias da máquina tiradas no pátio (máximo 4)"
    }
  },
  "required": [
    "serie"
  ]
}
