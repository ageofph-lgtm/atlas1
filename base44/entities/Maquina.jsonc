{
  "name": "Maquina",
  "type": "object",
  "properties": {
    "serie": {
      "type": "string",
      "description": "Número de série — chave de identificação"
    },
    "modelo": {
      "type": "string",
      "description": "Modelo da máquina"
    },
    "ano": {
      "type": "string",
      "description": "Ano de fabrico"
    },
    "foto_url": {
      "type": "string",
      "description": "URL da foto da máquina/placa"
    },
    "mastro": {
      "type": "string",
      "description": "Tipo de mastro (triplex, telescopico, niho, simplex)"
    },
    "elevacao_livre_150": {
      "type": "boolean",
      "description": "Mastro com elevação livre de 150 mm (versão dos EXV telescópicos). Muda o H1; só se grava quando a tabela de mastros tem essa versão para o modelo e mastro."
    },
    "vias_mastro": {
      "type": "string",
      "description": "Número de vias do mastro (3, 4, 5)"
    },
    "joystick": {
      "type": "string",
      "description": "Tipo de joystick (alavanca, minilever, 4plus, fingertrip)"
    },
    "tipo_pneu": {
      "type": "string",
      "description": "Cor do pneu (preto, branco)"
    },
    "h3": {
      "type": "string",
      "description": "Altura máxima do mastro em mm (H3)"
    },
    "h1": {
      "type": "string",
      "description": "Altura do mastro recolhido em mm (H1). Calculada pela tabela de mastros a partir de modelo + mastro + H3; não se escreve à mão."
    },
    "h1_origem": {
      "type": "string",
      "description": "De onde veio o H1: 'tabela' (valor da ficha) ou 'estimado' (H3 entre dois valores da ficha, interpolado). Vazio = sem H1."
    },
    "bateria": {
      "type": "string",
      "enum": [
        "chumbo",
        "litio"
      ],
      "description": "Tipo de bateria (chumbo, litio)"
    },
    "acessorios": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de acessórios"
    },
    "observacoes": {
      "type": "string",
      "description": "Observações gerais"
    },
    "horimetro": {
      "type": "string",
      "description": "Horas de trabalho marcadas no horímetro (opcional)"
    },
    "fotos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Fotografias da máquina tiradas no pátio (máximo 4) — as mais atuais"
    },
    "fotos_momento": {
      "type": "string",
      "description": "De que movimento são as fotos atuais: 'entrada' (chegada) ou 'saida'. Vazio = de antes da rotação."
    },
    "fotos_data": {
      "type": "string",
      "format": "date-time",
      "description": "Quando foram tiradas as fotos atuais"
    },
    "fotos_anteriores": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "O conjunto de fotos anterior ao atual (máximo 4). Roda a cada movimento com fotos novas: guarda-se só um conjunto atrás."
    },
    "fotos_anteriores_momento": {
      "type": "string",
      "description": "De que movimento são as fotos anteriores: 'entrada' ou 'saida'"
    },
    "fotos_anteriores_data": {
      "type": "string",
      "format": "date-time",
      "description": "Quando foram tiradas as fotos anteriores"
    },
    "miniaturas": {
      "type": "object",
      "description": "Miniaturas (~5 KB) das fotos atuais e anteriores, por endereço da foto. As listas mostram estas; a foto inteira só abre ao clicar."
    },
    "foto_miniatura_url": {
      "type": "string",
      "description": "Miniatura da foto da placa, para a lista do inventário"
    }
  },
  "required": [
    "serie"
  ]
}
