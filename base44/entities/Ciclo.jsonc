{
  "name": "Ciclo",
  "type": "object",
  "properties": {
    "maquina_id": {
      "type": "string",
      "description": "ID da M\u00e1quina associada"
    },
    "serie": {
      "type": "string",
      "description": "S\u00e9rie denormalizada para busca"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "str",
        "uts",
        "recon",
        "indefinida",
        "sucata"
      ],
      "description": "Categoria de classifica\u00e7\u00e3o"
    },
    "cone_cor": {
      "type": "string",
      "description": "Cor do cone de identifica\u00e7\u00e3o"
    },
    "cone_numero": {
      "type": "string",
      "description": "N\u00famero do cone"
    },
    "estado": {
      "type": "string",
      "enum": [
        "entrada",
        "classificada",
        "autorizada",
        "em_execucao",
        "pronta",
        "em_aluguer",
        "manutencao",
        "retorno",
        "fechado",
        "indefinido"
      ],
      "default": "entrada",
      "description": "Estado atual do ciclo"
    },
    "prioridade": {
      "type": "boolean",
      "default": false,
      "description": "Se \u00e9 prioridade"
    },
    "watcher_os_id": {
      "type": "string",
      "description": "ID do registo FrotaACP criado no Watcher"
    },
    "data_entrada": {
      "type": "string",
      "format": "date-time",
      "description": "Data de entrada no p\u00e1tio"
    },
    "data_classificacao": {
      "type": "string",
      "format": "date-time",
      "description": "Data de classifica\u00e7\u00e3o"
    },
    "data_autorizacao": {
      "type": "string",
      "format": "date-time",
      "description": "Data de autoriza\u00e7\u00e3o"
    },
    "data_pronta": {
      "type": "string",
      "format": "date-time",
      "description": "Data em que ficou pronta"
    },
    "data_saida": {
      "type": "string",
      "format": "date-time",
      "description": "Data de sa\u00edda para aluguer"
    },
    "data_retorno": {
      "type": "string",
      "format": "date-time",
      "description": "Data de retorno"
    },
    "dias_alugada": {
      "type": "number",
      "description": "Dias que esteve alugada"
    },
    "tipo_saida": {
      "type": "string",
      "enum": [
        "alugada",
        "vendida"
      ],
      "description": "Tipo de sa\u00edda (alugada ou vendida)"
    },
    "foto_saida": {
      "type": "string",
      "description": "URL da foto da placa na sa\u00edda"
    },
    "bateria_ns": {
      "type": "string",
      "description": "N\u00famero de s\u00e9rie da bateria que saiu com a m\u00e1quina"
    },
    "bateria_foto_url": {
      "type": "string",
      "description": "Foto da chapa de caracter\u00edsticas da bateria"
    },
    "carregador_ns": {
      "type": "string",
      "description": "N\u00famero de s\u00e9rie do carregador que saiu com a m\u00e1quina"
    },
    "carregador_foto_url": {
      "type": "string",
      "description": "Foto da chapa de caracter\u00edsticas do carregador"
    },
    "reserva_cliente": {
      "type": "string",
      "description": "Cliente da reserva"
    },
    "reserva_data": {
      "type": "string",
      "format": "date",
      "description": "Data prevista de sa\u00edda da reserva"
    },
    "reserva_comercial": {
      "type": "string",
      "description": "Nome do comercial que fez a reserva"
    },
    "reserva_comercial_id": {
      "type": "string",
      "description": "ID do comercial que reservou \u2014 para lhe enviar as notifica\u00e7\u00f5es desta m\u00e1quina"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es do ciclo"
    },
    "tarefas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "texto": {
            "type": "string",
            "description": "Descri\u00e7\u00e3o da tarefa"
          },
          "concluida": {
            "type": "boolean",
            "default": false,
            "description": "Se a tarefa est\u00e1 conclu\u00edda"
          }
        },
        "required": [
          "texto"
        ]
      },
      "description": "Tarefas da O.S. selecionadas na autoriza\u00e7\u00e3o (predefinidas + personalizadas)"
    }
  },
  "required": [
    "serie",
    "categoria",
    "estado"
  ]
}